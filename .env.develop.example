# Backend local/staging para la rama develop
APP_HOST=127.0.0.1
APP_PORT=8000
REACT_VITE_CONNECTION=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

ALGORITHM=HS256
SECRET_ACCESS_TOKEN=replace-with-a-develop-secret

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=proyecto_is2_develop
MONGODB_COLLECTION_USERS=users
MONGODB_COLLECTION_DOCUMENTS=documents

# BYOK: las claves llegan por solicitud desde el navegador.
OPENAI_API_KEY=
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

MAX_TOKENS=500
TEMPERATURE=0.2
NUMBER_OF_VECTORIAL_RESULTS=3
CHROMA_PATH=./chroma_data_develop
MEDIA_PATH=./media/develop
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=2
MAX_FILE_SIZE_BYTES=10485760
MAX_DOCUMENTS_PER_SESSION=5
MAX_STORAGE_BYTES_PER_SESSION=52428800
MAX_QUESTIONS_PER_SESSION=20
MAX_QUERY_LENGTH=2000
CHUNK_SIZE_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
REDIS_RATE_LIMIT_PREFIX=proyecto-is2:rate:develop
CLEANUP_INTERVAL_SECONDS=600
BACKUP_DIR=./backups/develop
BACKUP_RETENTION_DAYS=7
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.txt
