# Backend de production en Render Free + MongoDB Atlas Free.
# Reemplazar todos los valores entre < > antes de usarlo.
APP_HOST=0.0.0.0
APP_PORT=8000
REACT_VITE_CONNECTION=https://<frontend>.pages.dev
ALLOWED_ORIGINS=https://<frontend>.pages.dev
COOKIE_SECURE=true
COOKIE_SAMESITE=none

ALGORITHM=HS256
SECRET_ACCESS_TOKEN=<long-random-production-secret>

MONGODB_URI=mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=proyecto_is2
MONGODB_COLLECTION_USERS=users
MONGODB_COLLECTION_DOCUMENTS=documents

# BYOK: dejar vacío; el usuario envía la clave por solicitud.
OPENAI_API_KEY=
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

MAX_TOKENS=500
TEMPERATURE=0.2
NUMBER_OF_VECTORIAL_RESULTS=3

# Render Free no tiene Persistent Disk: estos datos son temporales.
CHROMA_PATH=/tmp/chroma_data
MEDIA_PATH=/tmp/media
BACKUP_DIR=/tmp/backups

# Con Persistent Disk, cambiar las tres rutas anteriores a /var/data/...
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=2
MAX_FILE_SIZE_BYTES=10485760
MAX_DOCUMENTS_PER_SESSION=5
MAX_STORAGE_BYTES_PER_SESSION=52428800
MAX_QUESTIONS_PER_SESSION=20
MAX_QUERY_LENGTH=2000
CHUNK_SIZE_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REDIS_URL=
REDIS_RATE_LIMIT_PREFIX=proyecto-is2:rate:production
CLEANUP_INTERVAL_SECONDS=600
BACKUP_RETENTION_DAYS=7
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.txt
